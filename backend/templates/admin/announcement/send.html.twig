<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pivní Konto - Poslat oznámení</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #1f2937; color: #f9fafb; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 1rem; }
        .box { background: #374151; padding: 2rem; border-radius: 12px; width: 100%; max-width: 560px; box-shadow: 0 4px 24px rgba(0,0,0,0.3); }
        h1 { text-align: center; margin-bottom: 1.25rem; font-size: 1.5rem; color: #f59e0b; }
        .alert { padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; text-align: center; font-size: 0.9rem; }
        .alert-success { background: #14532d; color: #bbf7d0; }
        .alert-danger { background: #991b1b; color: #fecaca; }
        label { display: block; margin-bottom: 0.25rem; font-size: 0.875rem; color: #9ca3af; }
        input[type="text"], textarea, select { width: 100%; padding: 0.75rem; border: 1px solid #4b5563; border-radius: 8px; background: #1f2937; color: #f9fafb; font-size: 1rem; margin-bottom: 1rem; font-family: inherit; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: #f59e0b; }
        textarea { min-height: 96px; resize: vertical; }
        select[multiple] { min-height: 120px; }
        .hint { font-size: 0.8rem; color: #9ca3af; margin-top: -0.75rem; margin-bottom: 1rem; }
        .checkbox-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem; }
        .checkbox-row input { width: auto; margin: 0; }
        .checkbox-row label { margin: 0; color: #f9fafb; font-size: 0.95rem; }
        .actions { display: flex; gap: 0.5rem; }
        .btn { flex: 1; padding: 0.75rem; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; text-align: center; text-decoration: none; display: inline-block; }
        .btn-primary { background: #f59e0b; color: #1f2937; }
        .btn-primary:hover { background: #d97706; }
        .btn-secondary { background: #4b5563; color: #f9fafb; }
        .btn-secondary:hover { background: #6b7280; }
    </style>
</head>
<body>
    <div class="box">
        <h1>📣 Poslat oznámení</h1>

        {% for label, messages in app.flashes(['success', 'danger']) %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_announce') }}">

            <label for="title">Titulek</label>
            <input type="text" id="title" name="title" maxlength="255" required autofocus placeholder="🎉 Novinka">

            <label for="message">Text</label>
            <textarea id="message" name="message" maxlength="500" required placeholder="Přibyly push notifikace! Zapni si je v profilu."></textarea>

            <label for="url">Odkaz v aplikaci</label>
            <input type="text" id="url" name="url" value="/" placeholder="/profile">
            <div class="hint">Kam vede klik z push notifikace (např. /profile).</div>

            <label for="recipients">Příjemci</label>
            <select id="recipients" name="recipients[]" multiple>
                {% for user in users %}
                    <option value="{{ user.id }}">{{ user.name }} ({{ user.email }})</option>
                {% endfor %}
            </select>
            <div class="hint">Nic nevybráno = všem ({{ users|length }} uživatelů). Ctrl/Cmd+klik pro výběr více lidí.</div>

            <div class="checkbox-row">
                <input type="checkbox" id="push" name="push" value="1">
                <label for="push">Poslat i jako push notifikaci do mobilu</label>
            </div>

            <div class="actions">
                <a href="{{ path('admin') }}" class="btn btn-secondary">Zpět</a>
                <button type="submit" class="btn btn-primary">Odeslat oznámení</button>
            </div>
        </form>
    </div>
</body>
</html>
